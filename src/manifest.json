{
  "manifest_version": 3,
  "name": "SaidNo",
  "description": "Says no to cookie banners, fixes pages that break when you do, and shows who keeps tracking you anyway.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content.js"],
      "match_origin_as_fallback": true,
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "host_permissions": ["*://*/*"],
  "permissions": ["scripting", "storage", "webRequest"],
  "action": {
    "default_title": "SaidNo",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src 'self'"
  }
}
